{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@shared/*": ["./lib/fightccf/shared/*"],
      "@/game": ["./components/mulerun/game/index.ts"],
      "@/game/*": ["./components/mulerun/game/*"],
      "@/data/*": ["./components/mulerun/data/*"],
      "@/stores/*": ["./components/mulerun/stores/*"],
      "@/services/*": ["./components/mulerun/services/*"],
      "@/components/*": ["./components/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "components/App.tsx", "lib/fightccf/game.ts"]
}
